{
  "name": "calous-vscode",
  "displayName": "Calous AI Assistant",
  "description": "VS Code extension for Calous AI assistant via Unix socket",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "calous.askQuestion",
        "title": "Ask Calous",
        "category": "Calous"
      },
      {
        "command": "calous.explainCode",
        "title": "Explain Code",
        "category": "Calous"
      },
      {
        "command": "calous.generateCode",
        "title": "Generate Code",
        "category": "Calous"
      },
      {
        "command": "calous.switchChat",
        "title": "Switch Chat Channel",
        "category": "Calous"
      },
      {
        "command": "calous.openChat",
        "title": "Open Chat",
        "category": "Calous",
        "icon": "$(comment-discussion)"
      }
    ],
    "keybindings": [
      {
        "command": "calous.openChat",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "calous.explainCode",
          "group": "calous",
          "when": "editorHasSelection"
        }
      ]
    },
    "configuration": {
      "title": "Calous",
      "properties": {
        "calous.socketPath": {
          "type": "string",
          "default": "/tmp/calous.sock",
          "description": "Path to Calous Unix socket"
        },
        "calous.defaultChatChannel": {
          "type": "number",
          "default": 1,
          "description": "Default chat channel to use"
        },
        "calous.timeout": {
          "type": "number",
          "default": 30000,
          "description": "Socket timeout in milliseconds"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "eslint": "^8.28.0",
    "typescript": "^4.9.4"
  }
}
